---
title: "CLI 已实现的并行状态"
---
stateDiagram-v2
  direction LR
  state "At the same time" as all {
    state "PDF 文本投递回执" as r0 {
      s0: 当前回执尚未开始
      s1: 文本已投递#65292;待确认
      s2: 当前文本块已确认
      s3: 旧回执需显式重置
      [*] --> s0
      s0 --> s1: 投递当前文本块
      s1 --> s2: 用匹配的块 ID 和摘要确认
      s2 --> s3: 已绑定的输入版本变化 [when 显式登记的采用值到报告依赖链 is 依赖当前#65292;报告已登记 and SQLite 检索缓存 is one of 同步进行中, 当前可检索]
      s3 --> s0: 显式重置旧回执#65292;保留历史
    }
    --
    state "显式登记的采用值到报告依赖链" as r1 {
      s4: 采用值尚未登记
      s5: 采用值当前#65292;报告待登记
      s6: 依赖当前#65292;报告已登记
      s7: 已绑定上游过期#65292;需复核
      s8: 采用值已重核#65292;报告待重登记
      [*] --> s4
      s4 --> s5: 复核后登记采用值
      s5 --> s6: 登记报告及实际上游
      s6 --> s7: 已绑定的输入版本变化 [when PDF 文本投递回执 is 当前文本块已确认 and SQLite 检索缓存 is one of 同步进行中, 当前可检索]
      s7 --> s8: 复核后登记采用值
      s8 --> s6: 登记报告及实际上游
    }
    --
    state "SQLite 检索缓存" as r2 {
      s9: 尚未入库
      s10: 同步进行中
      s11: 当前可检索
      s12: 输入已变#65292;同步需回滚
      s13: 索引过期#65292;查询被阻断
      [*] --> s9
      s9 --> s10: 捕获当前依赖快照
      s10 --> s11: 提交未变化的快照
      s10 --> s12: 已绑定的输入版本变化 [when PDF 文本投递回执 is 当前文本块已确认 and 显式登记的采用值到报告依赖链 is 依赖当前#65292;报告已登记]
      s11 --> s13: 已绑定的输入版本变化 [when PDF 文本投递回执 is 当前文本块已确认 and 显式登记的采用值到报告依赖链 is 依赖当前#65292;报告已登记]
      s12 --> s9: 检测变化并回滚
      s13 --> s10: 捕获当前依赖快照
    }
  }
